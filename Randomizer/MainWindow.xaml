<Window x:Class="Randomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Randomizer"
        mc:Ignorable="d"
        Title="Randomizer" Height="450" Width="800">
    <Grid Margin="0,0,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="89"></RowDefinition>
            <RowDefinition Height="102"></RowDefinition>
            <RowDefinition Height="139"></RowDefinition>
            <RowDefinition Height="129"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="GenerateButton" Content="Сгенерировать" Width="178" 
            Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" 
            Margin="312,10,0,65" Click="GenerateButton_Click" FontSize="18" FontFamily="Segoe UI Semibold">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                        CornerRadius="15" 
                        Background="#0078D7" 
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.Foreground>
                <SolidColorBrush Color="White"/>
            </Button.Foreground>
        </Button>
        <Label Content="Первое число" Grid.Row="0" Grid.Column="0" Margin="112,30,136,10" FontFamily="Segoe UI Semibold" FontSize="18"/>
        <Label Content="Второе число" Grid.Row="0" Grid.Column="1" Margin="112,30,132,0" FontFamily="Segoe UI Semibold" FontSize="18"/>
        <Label Name="resultLabel" Content="Дежурными будут..." HorizontalAlignment="Left" HorizontalContentAlignment="Center" Grid.Row="2" Grid.ColumnSpan="2" Margin="200,39,0,30" Width="400" FontSize="22" FontFamily="Segoe UI Semibold"></Label>

        <Border BorderThickness="2" Grid.Row="1" Grid.Column="0" CornerRadius="16" BorderBrush="Black" Height="45" Width="190">
            <TextBox Name="firstNum" Height="30" Width="175" BorderThickness="0" Padding="0, 5, 0, 0"></TextBox>
        </Border>
        <Border BorderThickness="2" Grid.Row="1" Grid.Column="1" CornerRadius="16" BorderBrush="Black" Height="45" Width="190">
            <TextBox x:Name="secondNum" Grid.Row="1" Grid.Column="1" Height="30" Width="175" BorderThickness="0" Padding="0, 5, 0, 0"></TextBox>
        </Border>

    </Grid>


</Window>
